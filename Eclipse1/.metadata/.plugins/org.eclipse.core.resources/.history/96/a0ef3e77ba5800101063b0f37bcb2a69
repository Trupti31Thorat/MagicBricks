public void switchToLatestWindow()
{
	String currentWindow = driver.getWindowHandle();
	for(String windowHandle: driver.getWindowHandles())

{
		if(!windowHandle.equals(currentWindow))
		{
			driver.switchTo().window(windowHandle);
				break;
		}
}	
}

