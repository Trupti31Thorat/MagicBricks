package com.pages;

import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.PageFactory;

public class HomeLoansPageFactory {
    private WebDriver driver;

    // Constructor
    public HomeLoansPageFactory(WebDriver driver) {
        this.driver = driver;
        PageFactory.initElements(driver, this);
    }

    // WebElements
    @FindBy(xpath = "(//a[text()=\"Home Loans\"])[2]")
    private WebElement homeLoansbtn;

    // Methods

public void clickHomeLoansLink() {
          if (homeLoansbtn != null) {
                 homeLoansbtn.click();
        } else {
        	
          throw new RuntimeException("Home Loans link is not initialized.");
 }

}

    public String getPageTitle() {
        return driver.getTitle();
    }
}



